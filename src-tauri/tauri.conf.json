{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AllDownloader",
  "version": "0.1.0",
  "identifier": "com.alldownloader.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "AllDownloader", "width": 900, "height": 575, "minWidth": 720, "minHeight": 500, "decorations": false, "shadow": true, "visible": false },
      { "label": "launcher", "title": "", "width": 64, "height": 64, "minWidth": 64, "minHeight": 64, "maxWidth": 470, "maxHeight": 392, "resizable": false, "decorations": false, "transparent": true, "shadow": false, "alwaysOnTop": true, "skipTaskbar": true, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"], "resources": ["binaries/aria2-next-x86_64-pc-windows-msvc.exe"], "windows": { "wix": { "language": ["zh-CN"] } } }
}
