{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AllDownloader",
  "version": "0.1.0",
  "identifier": "com.alldownloader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AllDownloader", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "windows": { "wix": { "language": ["zh-CN"] } } }
}
