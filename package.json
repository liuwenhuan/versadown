{
  "name": "versadown",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:launcher": "node scripts/smoke-launcher.cjs",
    "test:live:baidu-session": "node scripts/verify-baidu-session-live.cjs",
    "test:live:xunlei-auth": "node scripts/verify-xunlei-auth-live.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:linux:quick": "pnpm run build && VERSADOWN_FRONTEND_SIGNATURE=\"$(find dist -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d ' ' -f 1)\" cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol",
    "build:linux:release": "bash scripts/build-linux-release.sh",
    "build:windows:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Mode Quick",
    "build:windows:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Mode Release",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Mode Release",
    "build:windows:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Mode Release -Installer",
    "tauri:binary": "pnpm run build:windows",
    "tauri:build": "pnpm run build:windows:installer"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "ws": "^8.21.0"
  }
}
